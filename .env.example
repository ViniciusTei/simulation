# Copy this file to .env and fill in real values before running the app.

# Long random string used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The single account's login. Only used by `node --env-file=.env scripts/seed.mjs`.
SEED_USERNAME=
SEED_PASSWORD=

# Where the SQLite file lives. Defaults to ./data/app.db if unset.
DB_PATH=./data/app.db
